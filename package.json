{
  "name": "pulse",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:packages": "pnpm --filter @pulse/shared build && pnpm --filter @pulse/db build",
    "build:web:deploy": "pnpm --filter @pulse/db generate && pnpm build:packages && pnpm --filter @pulse/web build",
    "dev": "pnpm build:packages && concurrently -n web,worker -c blue,green \"pnpm --filter @pulse/web dev\" \"pnpm --filter @pulse/worker dev\"",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "doctor": "node scripts/doctor.mjs",
    "proof:check": "node scripts/recruiter-proof.mjs --check",
    "proof:refresh": "node scripts/recruiter-proof.mjs --write",
    "verify:fast": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm eval:check && pnpm proof:check",
    "verify:full": "pnpm run doctor && pnpm verify:fast && pnpm test:integration && pnpm build && pnpm test:e2e",
    "verify:release": "pnpm proof:check && pnpm smoke:remote && pnpm --filter @pulse/web audit:lighthouse",
    "load:demo": "k6 run scripts/k6/v3-demo.js",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage && node scripts/check-coverage-claims.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "pnpm --filter @pulse/web test:e2e",
    "smoke:remote": "pnpm --filter @pulse/web smoke:remote",
    "eval": "node --no-warnings --experimental-strip-types scripts/eval.ts",
    "eval:check": "pnpm eval:summary:check && pnpm eval:investigation:check",
    "db:push": "pnpm --filter @pulse/db db:push",
    "db:migrate": "pnpm --filter @pulse/db db:migrate",
    "db:seed": "pnpm --filter @pulse/shared build && pnpm --filter @pulse/db db:seed",
    "eval:summary:check": "node --no-warnings --experimental-strip-types scripts/eval.ts --check",
    "eval:investigation:check": "node --no-warnings --experimental-strip-types scripts/eval-investigation.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@pulse/db": "workspace:*",
    "@pulse/shared": "workspace:*",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^10.0.3",
    "eslint": "^9.39.5",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  }
}
