# Postgres connection string. Local default matches docker-compose.yml.
DATABASE_URL="postgresql://pulse:pulse@localhost:5432/pulse"

# Redis connection string for BullMQ.
REDIS_URL="redis://localhost:6379"

# Auth.js (next-auth v5) JWT signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-local-dev-secret"

# Base URL of the web app (used by Auth.js for callback URLs).
# Local dev runs on :3010 (not :3000) to avoid clashing with other local dev servers.
AUTH_URL="http://localhost:3010"

# Anthropic API key for AI-drafted incident summaries. Leave unset to run without AI (graceful degradation).
ANTHROPIC_API_KEY=""

# Model used for incident summaries. Default is the most capable; claude-haiku-4-5 is a cheaper option.
ANTHROPIC_MODEL="claude-opus-4-8"

# Independent copilot model and persisted AI safety controls.
ANTHROPIC_SUMMARY_MODEL="claude-opus-4-8"
ANTHROPIC_COPILOT_MODEL="claude-sonnet-4-6"
AI_ENABLED="false"
AI_DAILY_BUDGET_USD="5"
AI_RUN_MAX_COST_USD="0.50"
AI_ALLOW_UNPRICED="false"

# Optional server-side tracing. Start Jaeger locally with `docker compose --profile observability up -d`.
# Leave empty for the default no-op provider. Set to http://localhost:4318 after
# `docker compose --profile observability up -d` to export local traces to Jaeger.
OTEL_EXPORTER_OTLP_ENDPOINT=""
OTEL_SERVICE_NAME="pulse"

# Public demo safety and webhook replay protection.
DEMO_MODE="false"
WEBHOOK_REQUIRE_TIMESTAMP="false"

# Port the in-worker simulator (Hono server) listens on.
SIMULATOR_PORT=4001

# Base URL the worker uses to call its own simulator over HTTP.
SIMULATOR_BASE_URL="http://localhost:4001"

# Where the simulator POSTs inbound webhooks (lab results, claim acks). Web app URL.
WEBHOOK_TARGET_URL="http://localhost:3010"

# HMAC secret shared between simulator and web app to sign/verify webhook payloads.
WEBHOOK_SIGNING_SECRET="change-me-local-dev-webhook-secret"

# Password seeded for the three demo users (dana@lakeviewhealth.example, marcus@..., priya@...).
SEED_DEMO_PASSWORD="pulse-demo-2026"

# Exposed client-side so the login page's demo buttons can prefill the demo password.
# Fine for this demo org — never do this with a real password.
NEXT_PUBLIC_DEMO_PASSWORD="pulse-demo-2026"

# ── Health engine (doc 03 §4-5) ──────────────────────────────────────────────
# How often the health tick runs. Production default is 60s; the phase-7 walkthrough
# and the e2e suite shrink this so a demo does not take ten minutes.
HEALTH_TICK_SEC=60

# Minutes an incident must stay healthy in MONITORING before it auto-resolves, and the
# minutes DEGRADED must be sustained before a WARNING incident opens. Default 10.
INCIDENT_STABILITY_MIN=10

# Rolling health window in minutes (doc 03 §4). Default 15. The e2e suite shrinks this so the
# recovery leg of the demo does not have to wait for failures to age out in real time.
HEALTH_WINDOW_MIN=15
