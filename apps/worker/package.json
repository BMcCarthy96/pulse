{
  "name": "@pulse/worker",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "start:e2e": "tsx src/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "poke-simulator": "tsx --env-file=.env scripts/poke-simulator.ts",
    "enqueue-test-jobs": "tsx --env-file=.env scripts/enqueue-test-jobs.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@faker-js/faker": "^9",
    "@hono/node-server": "^1.19.17",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "@prisma/client": "^6",
    "@pulse/db": "workspace:*",
    "@pulse/shared": "workspace:*",
    "bullmq": "^5",
    "hono": "^4.13.3",
    "ioredis": "^5",
    "pino": "^9",
    "prisma": "^6"
  },
  "devDependencies": {
    "@types/node": "^22",
    "pino-pretty": "^13",
    "tsx": "^4",
    "typescript": "^5"
  }
}
