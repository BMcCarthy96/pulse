{
  "name": "@pulse/shared",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./webhook-signature": {
      "types": "./src/webhook-signature.ts",
      "default": "./dist/webhook-signature.js"
    },
    "./ai-budget": {
      "types": "./src/ai-budget.ts",
      "default": "./dist/ai-budget.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.0",
    "@prisma/client": "^6",
    "bullmq": "^5",
    "ioredis": "5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "typescript": "^6"
  }
}
