generator client {
  provider = "prisma-client-js"
  // Vercel's serverless runtime uses the RHEL OpenSSL 3 engine. Keep the
  // native target for local development and include the deployed runtime
  // explicitly so auth and demo provisioning can initialize Prisma.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Identity ────────────────────────────────────────────────

model Organization {
  id             String             @id @default(cuid())
  name           String
  slug           String             @unique
  createdAt      DateTime           @default(now())
  users          User[]
  connectors     Connector[]
  jobs           Job[]
  events         IntegrationEvent[]
  logs           LogEntry[]
  incidents      Incident[]
  aiRuns         AiRun[]
  auditEntries   AuditEntry[]
  demoSession    DemoSession?
  investigations Investigation[]
}

enum Role {
  ADMIN
  OPS
  VIEWER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id                    String                @id @default(cuid())
  orgId                 String
  org                   Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  email                 String
  name                  String
  passwordHash          String
  role                  Role                  @default(VIEWER)
  status                UserStatus            @default(ACTIVE)
  sessionVersion        Int                   @default(0)
  createdAt             DateTime              @default(now())
  auditEntries          AuditEntry[]
  aiRuns                AiRun[]
  demoSession           DemoSession?
  investigationsCreated Investigation[]       @relation("InvestigationCreator")
  actionsApproved       InvestigationAction[] @relation("InvestigationApprover")

  @@unique([orgId, email])
}

// ── Connectors & health ─────────────────────────────────────

enum ConnectorStatus {
  HEALTHY
  DEGRADED
  DOWN
  PAUSED
}

enum ChaosMode {
  HEALTHY
  DEGRADED // failureRate% of requests fail 500, latency +2-8s
  OUTAGE // all requests 503
  TIMEOUT // no response until client timeout
  RATE_LIMIT // 429 with Retry-After
  BAD_PAYLOAD // 200 but schema-invalid body
  AUTH_FAILURE // 401
}

model Connector {
  id              String          @id @default(cuid())
  orgId           String
  org             Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  key             String // "ehr-fhir" | "lab-results" | "claims" | "eligibility" | "erx"
  displayName     String
  description     String
  kind            String // "poll_sync" | "inbound_webhook" | "outbound_async" | "request_response"
  status          ConnectorStatus @default(HEALTHY)
  paused          Boolean         @default(false)
  chaosMode       ChaosMode       @default(HEALTHY)
  chaosConfig     Json            @default("{}")
  syncIntervalSec Int?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  syncRuns  SyncRun[]
  jobs      Job[]
  events    IntegrationEvent[]
  incidents Incident[]
  snapshots HealthSnapshot[]
  logs      LogEntry[]

  @@unique([orgId, key])
}

model HealthSnapshot {
  id           String          @id @default(cuid())
  connectorId  String
  connector    Connector       @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  status       ConnectorStatus
  errorRate    Float
  p95LatencyMs Int?
  totalCalls   Int
  failedCalls  Int
  windowStart  DateTime
  windowEnd    DateTime
  createdAt    DateTime        @default(now())

  @@index([connectorId, createdAt])
}

// ── Sync runs & jobs ────────────────────────────────────────

enum RunStatus {
  RUNNING
  SUCCEEDED
  FAILED
  PARTIAL
}

model SyncRun {
  id             String    @id @default(cuid())
  connectorId    String
  connector      Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  status         RunStatus @default(RUNNING)
  trigger        String // "schedule" | "manual"
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  recordsFetched Int       @default(0)
  recordsFailed  Int       @default(0)
  cursor         String?
  error          String?
  jobs           Job[]

  @@index([connectorId, startedAt])
}

enum JobStatus {
  QUEUED
  ACTIVE
  SUCCEEDED
  FAILED
  DEAD
}

model Job {
  id           String       @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  connectorId  String
  connector    Connector    @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  syncRunId    String?
  syncRun      SyncRun?     @relation(fields: [syncRunId], references: [id], onDelete: SetNull)
  queue        String
  type         String
  bullJobId    String?
  status       JobStatus    @default(QUEUED)
  attempts     Int          @default(0)
  maxAttempts  Int          @default(5)
  payload      Json
  lastError    String?
  errorHistory Json         @default("[]")
  scheduledFor DateTime?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([connectorId, status, createdAt])
  @@index([orgId, connectorId, status, createdAt])
  @@index([status, createdAt])
}

// ── Events (webhooks in/out) ────────────────────────────────

enum EventDirection {
  INBOUND
  OUTBOUND
}

enum EventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  DUPLICATE
  INVALID
}

model IntegrationEvent {
  id          String         @id @default(cuid())
  orgId       String
  org         Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  connectorId String
  connector   Connector      @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  direction   EventDirection
  eventType   String
  dedupeKey   String?
  status      EventStatus    @default(RECEIVED)
  payload     Json
  headers     Json?
  error       String?
  receivedAt  DateTime       @default(now())
  processedAt DateTime?

  @@unique([connectorId, dedupeKey])
  @@index([connectorId, receivedAt])
  @@index([orgId, connectorId, receivedAt])
}

// ── Logs ────────────────────────────────────────────────────

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

model LogEntry {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  level       LogLevel
  source      String // "worker" | "web" | "simulator"
  connectorId String?
  connector   Connector?   @relation(fields: [connectorId], references: [id], onDelete: SetNull)
  jobId       String?
  syncRunId   String?
  incidentId  String?
  traceId     String?
  message     String
  context     Json         @default("{}")
  createdAt   DateTime     @default(now())

  @@index([connectorId, createdAt])
  @@index([orgId, connectorId, createdAt])
  @@index([level, createdAt])
  @@index([traceId, createdAt])
}

// ── Incidents ───────────────────────────────────────────────

enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  MONITORING
  RESOLVED
}

enum IncidentSeverity {
  CRITICAL
  WARNING
}

model Incident {
  id              String                  @id @default(cuid())
  orgId           String
  org             Organization            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  connectorId     String
  connector       Connector               @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  status          IncidentStatus          @default(OPEN)
  severity        IncidentSeverity
  title           String
  openedAt        DateTime                @default(now())
  acknowledgedAt  DateTime?
  resolvedAt      DateTime?
  detectionSource String                  @default("health-engine")
  aiSummary       Json?
  aiSummaryStatus String                  @default("none")
  timeline        IncidentTimelineEntry[]
  aiRuns          AiRun[]
  investigations  Investigation[]

  @@index([connectorId, status])
  @@index([orgId, status, openedAt])
}

model IncidentTimelineEntry {
  id         String   @id @default(cuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  kind       String // "opened" | "status_change" | "note" | "ai_summary" | "health_transition" | "retry_burst"
  message    String
  actor      String // "system" | userId
  createdAt  DateTime @default(now())

  @@index([incidentId, createdAt])
}

// ── Audit ───────────────────────────────────────────────────

enum AiRunKind {
  SUMMARY
  COPILOT
  INVESTIGATION
}

enum AiRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  REFUSED
  CANCELLED
  BUDGET_EXCEEDED
}

enum AiCallStatus {
  OK
  FAILED
  REFUSED
}

enum InvestigationStatus {
  ACTIVE
  COMPLETED
  EXPIRED
}

enum EvidenceKind {
  LOG
  JOB
  EVENT
  HEALTH_SNAPSHOT
  TIMELINE
}

enum InvestigationActionType {
  RETRY_JOB
  ACKNOWLEDGE_INCIDENT
  RESOLVE_INCIDENT
  REGENERATE_SUMMARY
}

enum InvestigationActionStatus {
  PROPOSED
  EXECUTING
  SUCCEEDED
  FAILED
  DISMISSED
  STALE
}

enum InvestigationMode {
  LIVE
  RECORDED
}

enum DemoSessionStatus {
  ACTIVE
  EXPIRED
  DELETING
}

model DemoSession {
  id         String            @id @default(cuid())
  orgId      String            @unique
  org        Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId     String            @unique
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String            @unique
  status     DemoSessionStatus @default(ACTIVE)
  expiresAt  DateTime
  lastSeenAt DateTime          @default(now())
  createdAt  DateTime          @default(now())

  @@index([status, expiresAt])
}

model Investigation {
  id          String                  @id @default(cuid())
  orgId       String
  org         Organization            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  incidentId  String
  incident    Incident                @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User                    @relation("InvestigationCreator", fields: [createdById], references: [id], onDelete: Cascade)
  status      InvestigationStatus     @default(ACTIVE)
  title       String
  report      Json?
  startedAt   DateTime                @default(now())
  completedAt DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  evidence    InvestigationEvidence[]
  actions     InvestigationAction[]
  aiRuns      AiRun[]

  @@index([orgId, createdAt])
  @@index([incidentId, status])
}

model InvestigationEvidence {
  id              String        @id @default(cuid())
  investigationId String
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  kind            EvidenceKind
  sourceId        String
  label           String
  excerpt         String
  href            String?
  observedAt      DateTime?
  metadata        Json          @default("{}")
  createdAt       DateTime      @default(now())

  @@unique([investigationId, kind, sourceId])
  @@index([investigationId, createdAt])
}

model InvestigationAction {
  id              String                    @id @default(cuid())
  investigationId String
  investigation   Investigation             @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  type            InvestigationActionType
  targetId        String
  rationale       String
  evidenceIds     Json
  payload         Json                      @default("{}")
  status          InvestigationActionStatus @default(PROPOSED)
  result          Json?
  errorCode       String?
  errorMessage    String?
  approvedById    String?
  approvedBy      User?                     @relation("InvestigationApprover", fields: [approvedById], references: [id])
  proposedAt      DateTime                  @default(now())
  approvedAt      DateTime?
  executedAt      DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@index([investigationId, status])
}

// One logical AI operation. A retry reuses this row and adds another AiCall, so dashboards can
// distinguish user-visible generations from provider attempts and their accumulated cost.
model AiRun {
  id                            String            @id @default(cuid())
  orgId                         String
  org                           Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  incidentId                    String?
  incident                      Incident?         @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  userId                        String?
  user                          User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  investigationId               String?
  investigation                 Investigation?    @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  kind                          AiRunKind
  status                        AiRunStatus       @default(QUEUED)
  mode                          InvestigationMode @default(LIVE)
  model                         String
  promptVersion                 String
  question                      String?
  answer                        String?
  toolEvents                    Json?
  contextChars                  Int?
  contextTruncated              Boolean           @default(false)
  totalInputTokens              Int               @default(0)
  totalOutputTokens             Int               @default(0)
  totalCacheCreationInputTokens Int               @default(0)
  totalCacheReadInputTokens     Int               @default(0)
  totalCostUsd                  Decimal?          @db.Decimal(12, 6)
  latencyMs                     Int?
  errorCode                     String?
  errorMessage                  String?
  traceId                       String?
  startedAt                     DateTime?
  completedAt                   DateTime?
  createdAt                     DateTime          @default(now())
  calls                         AiCall[]

  @@index([orgId, createdAt])
  @@index([incidentId, createdAt])
  @@index([kind, status, createdAt])
}

model AiCall {
  id                       String       @id @default(cuid())
  runId                    String
  run                      AiRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  sequence                 Int
  attempt                  Int          @default(1)
  providerRequestId        String?
  model                    String
  inputTokens              Int          @default(0)
  outputTokens             Int          @default(0)
  cacheCreationInputTokens Int          @default(0)
  cacheReadInputTokens     Int          @default(0)
  pricingVersion           String?
  costUsd                  Decimal?     @db.Decimal(12, 6)
  latencyMs                Int
  status                   AiCallStatus
  errorCode                String?
  errorMessage             String?
  createdAt                DateTime     @default(now())

  @@unique([runId, sequence])
  @@index([runId, createdAt])
}

model AuditEntry {
  id         String       @id @default(cuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  action     String
  targetType String
  targetId   String
  metadata   Json         @default("{}")
  createdAt  DateTime     @default(now())

  @@index([orgId, createdAt])
}
