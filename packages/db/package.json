{
  "name": "@pulse/db",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "metrics": "tsx --env-file=.env scripts/metrics.ts"
  },
  "dependencies": {
    "@faker-js/faker": "^9",
    "@prisma/client": "^6",
    "@pulse/shared": "workspace:*",
    "bcryptjs": "^2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2",
    "@types/node": "^26",
    "prisma": "^6",
    "tsx": "^4",
    "typescript": "^5"
  }
}
